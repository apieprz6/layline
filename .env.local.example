# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth — LOCAL SUPABASE ONLY (ADR 0020)
# These are read by `supabase start` for the env() substitution in supabase/config.toml. The Next app
# never sees them: the OAuth handshake is Supabase's, so the hosted project holds its own copy of
# these credentials in its dashboard and they do NOT belong in Vercel's env.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

# Claude API (for LLM analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Weather APIs (add as you integrate sources)
NOAA_API_KEY=optional-if-needed
WINDY_API_KEY=your-windy-api-key
PREDICTWIND_API_KEY=your-predictwind-api-key

# Application Settings
# `npm run dev` serves port 4000 (package.json), not 3000.
NEXT_PUBLIC_APP_URL=http://localhost:4000
